# 复制为 .env 后按需修改；Portainer 建 stack 时也可用界面里的环境变量表填写。

# 镜像 tag：<打包版本>-dsh<官方版本>，latest 指向最新构建
DSH_IMAGE_TAG=1.0.5-dsh0.2.2-rc.5

# 你自己的 dsh 反代链接（nginxwebui 等反代指向本容器 3081）
DSH_PUBLIC_URL=https://dsh.mydomain.com:20443/

# 额外受信 authority，逗号或空格分隔（留空则只信任反代链接 + 容器自身地址）
DSH_TRUSTED_HOSTS=

# 时区（IANA 名称）；或改用 docker-compose.yml 里注释掉的 /etc/localtime 挂载
TZ=Asia/Shanghai

# 注入代理在宿主回环上的调试端口（容器内固定 3081）
DSH_INJECTOR_PORT=3081
